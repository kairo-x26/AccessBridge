# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 32+ random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AB_JWT_SECRET=replace-me-with-48-random-url-safe-characters-xxxxxxxx
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AB_FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
AB_MESSAGING_WEBHOOK_SECRET=replace-with-the-messaging-provider-signing-secret
AB_METRICS_TOKEN=replace-with-a-scrape-token
# deterministic (no model calls) or anthropic (requires a BAA before any PHI is sent)
AB_LLM_PROVIDER=deterministic
AB_ANTHROPIC_API_KEY=
WEB_ORIGIN=http://localhost:3000
# 1 shows demo account hints on the sign-in page; use only with synthetic data
NEXT_PUBLIC_DEMO=0
